<%- include("partials/header.ejs") %>

<section class="content-card form-card">
    <h1>Updating Quote Data</h1>
    <div class="card-divider"></div>

    <form method="POST" action="/quote/edit">
        <input type="hidden" name="quoteId" value="<%= quoteInfo[0].quoteId %>">

        <div class="form-row">
            <label for="quote">Quote:</label>
            <textarea id="quote" name="quote" required><%= quoteInfo[0].quote %></textarea>
        </div>

        <div class="form-row">
            <label for="authorId">Author:</label>
            <select id="authorId" name="authorId" required>
                <% for (let author of authors) { %>
                    <option value="<%= author.authorId %>" <%= author.authorId == quoteInfo[0].authorId ? "selected" : "" %>>
                        <%= author.firstName %> <%= author.lastName %>
                    </option>
                <% } %>
            </select>
        </div>

        <div class="form-row">
            <label for="category">Category:</label>
            <input type="text" id="category" name="category" value="<%= quoteInfo[0].category %>" required>
        </div>

        <div class="form-row">
            <label for="likes">Likes:</label>
            <input type="number" id="likes" name="likes" value="<%= quoteInfo[0].likes %>" min="0" required>
        </div>

        <button class="submit-button" type="submit">Update Quote</button>
    </form>
</section>

<%- include("partials/footer.ejs") %>
