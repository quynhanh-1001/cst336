<%- include("partials/header.ejs") %>

<section class="content-card form-card">
    <h1>Updating Author Data</h1>
    <div class="card-divider"></div>

    <form method="POST" action="/author/edit">
        <input type="hidden" name="authorId" value="<%= authorInfo[0].authorId %>">

        <div class="form-row">
            <label for="fName">First Name:</label>
            <input type="text" id="fName" name="fName" value="<%= authorInfo[0].firstName %>" required>
        </div>

        <div class="form-row">
            <label for="lName">Last Name:</label>
            <input type="text" id="lName" name="lName" value="<%= authorInfo[0].lastName %>" required>
        </div>

        <div class="form-row">
            <label for="dob">Date of Birth:</label>
            <input type="date" id="dob" name="dob" value="<%= authorInfo[0].dobISO %>" required>
        </div>

        <div class="form-row">
            <label for="dod">Date of Death:</label>
            <input type="date" id="dod" name="dod" value="<%= authorInfo[0].dodISO || '' %>">
        </div>

        <div class="form-row">
            <span class="form-label">Sex:</span>
            <div class="radio-group">
                <label>
                    <input type="radio" name="sex" value="M" <%= authorInfo[0].sex === "M" ? "checked" : "" %>>
                    Male
                </label>
                <label>
                    <input type="radio" name="sex" value="F" <%= authorInfo[0].sex === "F" ? "checked" : "" %>>
                    Female
                </label>
            </div>
        </div>

        <div class="form-row">
            <label for="profession">Profession:</label>
            <input type="text" id="profession" name="profession" value="<%= authorInfo[0].profession %>" required>
        </div>

        <div class="form-row">
            <label for="country">Country:</label>
            <input type="text" id="country" name="country" value="<%= authorInfo[0].country %>" required>
        </div>

        <div class="form-row">
            <label for="portrait">Portrait URL:</label>
            <input type="text" id="portrait" name="portrait" value="<%= authorInfo[0].portrait || '' %>">
        </div>

        <div class="form-row">
            <label for="biography">Biography:</label>
            <textarea id="biography" name="biography"><%= authorInfo[0].biography || '' %></textarea>
        </div>

        <button class="submit-button" type="submit">Update Author</button>
    </form>
</section>

<%- include("partials/footer.ejs") %>
