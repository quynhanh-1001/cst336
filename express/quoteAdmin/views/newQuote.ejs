<%- include("partials/header.ejs") %>

<section class="content-card form-card">
    <h1>Adding a New Quote</h1>
    <div class="card-divider"></div>

    <form method="POST" action="/quote/new">
        <div class="form-row">
            <label for="quote">Quote:</label>
            <textarea id="quote" name="quote" required></textarea>
        </div>

        <div class="form-row">
            <label for="authorId">Author:</label>
            <select id="authorId" name="authorId" required>
                <% for (let author of authors) { %>
                    <option value="<%= author.authorId %>">
                        <%= author.firstName %> <%= author.lastName %>
                    </option>
                <% } %>
            </select>
        </div>

        <div class="form-row">
            <label for="category">Category:</label>
            <input type="text" id="category" name="category" required>
        </div>

        <div class="form-row">
            <label for="likes">Likes:</label>
            <input type="number" id="likes" name="likes" value="0" min="0" required>
        </div>

        <button class="submit-button" type="submit">Add Quote</button>
    </form>

    <% if (typeof message !== "undefined") { %>
        <p class="success-message"><%= message %></p>
    <% } %>
</section>

<%- include("partials/footer.ejs") %>
